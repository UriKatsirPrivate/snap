GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash-lite

# local | cloudsql
RECORDS_BACKEND=local
LOCAL_RECORDS_PATH=data/decisions.jsonl

# Required when RECORDS_BACKEND=cloudsql. CLOUDSQL_INSTANCE is the instance
# connection name (project:region:instance); CLOUDSQL_USER is an IAM database
# user (e.g. a service account email, minus ".gserviceaccount.com").
CLOUDSQL_INSTANCE=
CLOUDSQL_DATABASE=snap
CLOUDSQL_USER=

# Required to use DELETE /v1/decisions (send as the X-Admin-Key header).
# Endpoint is disabled (503) when unset.
ADMIN_API_KEY=
